# ============================================================
# .env — Painel Yup (arquivo único, completo)
# Renomeie este arquivo para ".env" na pasta painel_yup
# ============================================================
# O server.js publicado lê este arquivo direto (parser próprio, sem dotenv).
# As variáveis SEM prefixo VITE_ são lidas apenas pelo server.js e NÃO
# entram no bundle do navegador. As com VITE_ entram.
# ============================================================

# ---- API do WhatsApp (Backend existente) ----
VITE_API_WHATSAPP_URL=http://2.25.147.117:8081

# ---- API do Painel (Autenticação e MongoDB) - USAR O IP PÚBLICO ----
VITE_API_PAINEL_URL=http://2.25.147.117:3000

# ---- MongoDB Atlas - lido pelo server.js (sem VITE_, fica fora do bundle) ----
MONGODB_URI=mongodb+srv://plablo:Yupaper8882@cluster0.t0ozb1f.mongodb.net/?appName=Cluster0
MONGODB_DB=painel_yup

# ---- MongoDB Atlas - versão VITE_ (mantida como estava) ----
VITE_MONGODB_URI=mongodb+srv://plablo:Yupaper8882@cluster0.t0ozb1f.mongodb.net/?appName=Cluster0
VITE_MONGODB_DB=painel_yup

# ---- Porta do painel ----
PORT=3000

# ---- Configurações do Sistema ----
VITE_JWT_SECRET=yup_painel_jwt_secret_2026

# ---- Usuário Admin Inicial ----
VITE_ADMIN_LOGIN=adm
VITE_ADMIN_PASSWORD=#Filial@2026

# Senha inicial do adm lida pelo server.js (só usada se o usuário 'adm'
# ainda não existir no banco — hoje ele já existe, então não altera nada)
ADMIN_SENHA_INICIAL=#Filial@2026